      "name": "Get Users List",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"User ID is 1\", function () {\r",
              "    const jsonData = pm.response.json();\r",
              "    pm.expect(jsonData.id).to.equal(1);\r",
              "});\r",
              "\r",
              "pm.test(\"User has name and email\", function () {\r",
              "    const jsonData = pm.response.json();\r",
              "    pm.expect(jsonData.name).to.be.a('string');\r",
              "    pm.expect(jsonData.email).to.be.a('string');\r",
              "});\r",
              "\r",
              "pm.test(\"User has address with city\", function () {\r",
              "    const jsonData = pm.response.json();\r",
              "    pm.expect(jsonData.address).to.have.property('city');\r",
              "});"
